e":"content-section content-intro","children":[["$","div",null,{"className":"section-kicker","children":[["$","span",null,{"children":"Naš pristup"}],["$","span",null,{"className":"line"}]]}],["$","div",null,{"className":"editorial-grid","children":[["$","h2",null,{"children":["Prostor govori",["$","br",null,{}],["$","em",null,{"children":"više od riječi."}]]}],["$","div",null,{"className":"long-copy","children":[["$","p",null,{"children":"U svijetu gdje prostor govori više od riječi, naš dizajn postaje priča o eleganciji, ravnoteži i osobnom identitetu. Svaki interijer koji stvaramo rezultat je pažljivo promišljenog procesa u kojem se estetika i funkcionalnost stapaju u savršenu cjelinu."}],["$","p",null,{"children":"Naš pristup temelji se na razumijevanju klijenta — njegovih želja, potreba i životnog stila. Vjerujemo da vrhunski dizajn nije samo vizualni dojam, već iskustvo življenja u prostoru koji inspirira, umiruje i traje."}]]}]]}]]}],["$","section",null,{"className":"content-section dark-section","children":[["$","div",null,{"className":"section-kicker","children":[["$","span",null,{"children":"Naše vrijednosti"}],["$","span",null,{"className":"line"}]]}],["$","div",null,{"className":"principle-grid","children":[["$","article","Unikatnost u svakom detalju",{"children":[["$","span",null,{"children":"01"}],["$","h2",null,{"children":"Unikatnost u svakom detalju"}],["$","p",null,{"children":"Ne stvaramo kopije. Svaki projekt nosi vlastiti karakter, oblikovan s posebnom pažnjom prema detaljima, materijalima i proporcijama. Naš dizajn odražava profinjenost, suvremenost i bezvremensku eleganciju."}]]}],["$","article","Funkcionalnost bez kompromisa",{"children":[["$","span",null,{"children":"02"}],["$","h2",null,{"children":"Funkcionalnost bez kompromisa"}],["$","p",null,{"children":"Estetika je važna, ali funkcionalnost je temelj svakog kvalitetnog prostora. Svaki element ima svoju svrhu i svaki raspored svoju logiku — stvaramo prostore koji su jednako lijepi koliko i praktični za svakodnevni život."}]]}],["$","article","Potpuna posvećenost projektu",{"children":[["$","span",null,{"children":"03"}],["$","h2",null,{"children":"Potpuna posvećenost projektu"}],["$","p",null,{"children":"Klijentima stojimo na raspolaganju tijekom cijelog procesa — od prve ideje do završne realizacije. Vodimo projekt s maksimalnom pažnjom, koordiniramo sve faze izvedbe i osiguravamo da svaki detalj bude izveden prema najvišim standardima."}]]}],"$L9","$La"]}]]}],"$Lb","$Lc","$Ld","$Le"]}]
9:["$","article","Povjerenje i profesionalnost",{"children":[["$","span",null,{"children":"04"}],["$","h2",null,{"children":"Povjerenje i profesionalnost"}],["$","p",null,{"children":"Gradimo dugoročne odnose temeljene na povjerenju, transparentnosti i profesionalnom pristupu. Naš tim stručnjaka jamči sigurnost, pouzdanost i besprijekornu izvedbu svakog projekta."}]]}]
a:["$","article","Više od dizajna — stvaramo vrijednost",{"children":[["$","span",null,{"children":"05"}],["$","h2",null,{"children":"Više od dizajna — stvaramo vrijednost"}],["$","p",null,{"children":"Naši interijeri nisu samo prostori — oni su investicija u kvalitetu života, stil i dugotrajnu vrijednost. Dizajn koji nadilazi trendove i ostavlja snažan dojam."}]]}]
b:["$","section",null,{"className":"content-section why-section","children":[["$","div",null,{"className":"editorial-grid","children":[["$","div",null,{"children":[["$","p",null,{"className":"eyebrow","children":"Interior design projekt"}],["$","h2",null,{"children":["Zašto odabrati",["$","br",null,{}],["$","em",null,{"children":"dizajnera?"}]]}]]}],["$","div",null,{"className":"long-copy","children":["$","p",null,{"className":"large-copy","children":"Savršen interijer ne nastaje slučajno — on se pažljivo stvara. Profesionalni dizajner interijera pretvara prostor u iskustvo, estetiku u emociju, a vaš dom u odraz vašeg stila i osobnosti."}]}]]}],["$","div",null,{"className":"reason-list","children":[["$","article","Vizija i stručnost",{"children":[["$","span",null,{"children":"01"}],["$","h3",null,{"children":"Vizija i stručnost"}],["$","p",null,{"children":"Dizajner vidi prostor iz druge perspektive. Kombinacijom proporcija, tekstura, boja i svjetla stvara sklad koji odiše elegancijom i profinjenošću."}]]}],["$","article","Luksuz kroz detalje",{"children":[["$","span",null,{"children":"02"}],["$","h3",null,{"children":"Luksuz kroz detalje"}],["$","p",null,{"children":"Svaki materijal, svaki komad namještaja i svaki ton boje biraju se s pažnjom. Detalji čine razliku između prostora koji je lijep i prostora koji oduzima dah."}]]}],["$","article","Vrijeme je luksuz — uštedite ga",{"children":[["$","span",null,{"children":"03"}],["$","h3",null,{"children":"Vrijeme je luksuz — uštedite ga"}],["$","p",null,{"children":"Profesionalni pristup znači besprijekornu organizaciju. Od ideje do realizacije, sve se odvija s lakoćom, bez stresa i izgubljenog vremena."}]]}],["$","article","Personalizirani dizajn",{"children":[["$","span",null,{"children":"04"}],["$","h3",null,{"children":"Personalizirani dizajn"}],["$","p",null,{"children":"Vaš dom, vaš stil. Dizajner kreira prostor koji nosi vašu energiju, prilagođen načinu života, navikama i željama — jer pravi luksuz je živjeti u prostoru koji vas predstavlja."}]]}],["$","article","Savršenstvo izvedbe",{"children":[["$","span",null,{"children":"05"}],["$","h3",null,{"children":"Savršenstvo izvedbe"}],["$","p",null,{"children":"Od prve skice do posljednjeg detalja, sve je pod kontrolom stručnjaka koji jamči vrhunsku kvalitetu i besprijekornu završnicu."}]]}]]}]]}]
